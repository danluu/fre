  "timing": {
    "warmup_iterations": 3,
    "measured_iterations": 9
  },
  "dimensions": [
    {
      "id": "changing-haystacks",
      "status": "covered",
      "detail": "Every generated family has multiple immutable haystacks; hot samples rotate them."
    },
    {
      "id": "one-shot-hot-reuse",
      "status": "covered",
      "detail": "Correctness receipts distinguish construction-per-operation from one construction reused for the case."
    },
    {
      "id": "positive-negative-short-long-adversarial",
      "status": "covered",
      "detail": "Oracle-classified positives, targeted negatives, empty/short inputs, inputs through 65537 bytes, and overlapping-prefix adversaries are frozen."
    },
    {
      "id": "anchors-empty-ascii-bytes",
      "status": "covered",
      "detail": "Absolute anchors, empty/nullable matches, NUL, 0xFF, and the complete byte class are present under Unicode-off byte semantics."
    },
    {
      "id": "multi-literal-languages",
      "status": "covered",
      "detail": "Single regexes containing disjoint English alternatives and overlapping a-prefix alternatives are included."
    },
    {
      "id": "pattern-fleets",
      "status": "future",
      "detail": "Independent 1/1000/10000+ compiled-pattern fleets, cache churn, and Zipf-distributed pattern rotation are not executed by v1."
    },
    {
      "id": "mixed-regex-shapes",
      "status": "covered",
      "detail": "Classes, concatenation, ordered alternation, bounded and unbounded repetition, and optional suffixes are included."
    },
    {
      "id": "captures",
      "status": "unsupported",
      "detail": "Only capture-free find/exists/end values are compared; capture group values and histories are not covered."
    },
    {
      "id": "unicode-text",
      "status": "unsupported",
      "detail": "The frozen oracle profile is regex::bytes with Unicode disabled; Unicode scalar semantics and UTF-8 boundary filtering are absent."
    },
    {
      "id": "re2-profiles",
      "status": "future",
      "detail": "RE2 Perl UTF-8, Latin1, POSIX, and longest-match profiles are not oracle-covered; v1 is Rust-regex bytes Unicode-off leftmost-first only."
    },
    {
      "id": "replacement-split",
      "status": "future",
      "detail": "Replacement expansion and split iteration have no candidate API in this harness."
    },
    {
      "id": "streaming-vectored",
      "status": "future",
      "detail": "Chunked streams and vectored haystacks are declared but not executed."
    },
    {
      "id": "concurrency",
      "status": "future",
      "detail": "Shared-matcher multi-thread correctness and contention are not executed."
    },
    {
      "id": "jit-denied",
      "status": "future",
      "detail": "Execution with executable-memory/JIT permission denied is not exercised."
    },
    {
      "id": "memory-pressure",
      "status": "future",
      "detail": "Allocator failure injection, cgroup limits, and page-pressure behavior are not exercised."
    },
    {
      "id": "architecture-aarch64",
      "status": "runtime-required",
      "detail": "The portable correctness suite is architecture-neutral, but an AArch64 receipt must be generated on an actual AArch64 host before architecture coverage is claimed."
    },
    {
      "id": "architecture-x86_64",
      "status": "runtime-required",
      "detail": "The portable correctness suite is architecture-neutral, but an x86_64 receipt must be generated on an actual x86_64 host before architecture coverage is claimed."
    },
    {
      "id": "performance",
      "status": "partial",
      "detail": "Raw compile/search timings are diagnostic-only, host-specific, threshold-free, and forbidden as planner feedback."
    }
  ],
